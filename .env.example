# Credenciales de la base de datos del centro medico.
# Copiar este archivo como .env y ajustar los valores reales del entorno.
# El archivo .env NO debe versionarse (esta listado en .gitignore).

BD_SERVIDOR=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=root
BD_CLAVE=
BD_ESQUEMA=centromedico
BD_CHARSET=utf8mb4
BD_MODO_SQL=STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION
